# ---------------------------------------------------------------------------
# Voyana environment. Copy to .env and fill in. NEVER commit real secrets.
# All values are read server-side only; none are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Supabase (cloud) -------------------------------------------------------
# From your project's API settings (Project Settings → API):
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""      # public anon key (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=""          # SECRET — server only, bypasses RLS. Never expose.

# Postgres connection (Project Settings → Database → Connection string → URI).
# Use the pooled connection (port 6543, ?pgbouncer=true) for the app runtime, and
# the direct connection (port 5432) for running migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Session signing secret (change in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL (used in emails and integration webhook display)
APP_URL="http://localhost:3100"

# --- Google Ads native Lead Form webhook -----------------------------------
# In Google Ads, set the Lead Form's Webhook URL to  <APP_URL>/api/leads/google
# and the "Key" to the same value below. Requests with a mismatched key are rejected.
GOOGLE_LEADS_WEBHOOK_KEY=""

# --- Meta (Facebook/Instagram) Lead Ads webhook ----------------------------
# Webhook URL: <APP_URL>/api/leads/meta
META_VERIFY_TOKEN=""          # any string; must match the value entered in Meta
META_APP_SECRET=""            # used to verify X-Hub-Signature-256
META_PAGE_TOKEN=""            # (optional) Graph API page token to fetch full lead field_data

# --- Internal Lead API (partner sites / landing pages / apps) ---------------
# POST <APP_URL>/api/v1/leads with header  x-api-key: <VOYANA_API_KEY>
VOYANA_API_KEY=""

# --- Transactional email (Resend HTTP API) ---------------------------------
# If RESEND_API_KEY is unset, emails are skipped (dev logs to console). Lead
# creation, agent signup, and every business transaction never depend on
# email succeeding — only email VERIFICATION itself is blocked without it
# (the account simply stays on the "verify your email" screen).
# Get RESEND_API_KEY from https://resend.com/api-keys (requires the sending
# domain below verified in the Resend dashboard).
#
# Category → sender mapping (all under one verified Resend domain — no
# separate API keys needed):
#   verify   → verify@<EMAIL_SEND_DOMAIN>
#   leads    → leads@<EMAIL_SEND_DOMAIN>
#   bookings → bookings@<EMAIL_SEND_DOMAIN>
#   support  → support@<EMAIL_SEND_DOMAIN>
#   account  → account@<EMAIL_SEND_DOMAIN>
RESEND_API_KEY=""
EMAIL_SEND_DOMAIN="send.mokshbooking.app"
EMAIL_FROM_NAME="Moksh Booking"
EMAIL_VERIFICATION_EXPIRES_MINUTES="15"
ADMIN_EMAIL=""                # receives new-lead notifications

# --- Payments (Razorpay) — architecture prepared, not yet wired -------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Note: GA4 / Google Ads / Meta Pixel tracking IDs are configured in the
# admin Settings page (stored in the database), not here.

# --- Redis cache (Upstash — HTTP-based, works on Vercel serverless) ---------
# Optional. If unset, the app reads directly from Supabase Postgres every
# time — correct, just uncached. Server-only; never expose with NEXT_PUBLIC_.
# From the Upstash console: Redis database → REST API → copy both values.
# Only used to cache PUBLIC read-only content (destinations, packages, site
# settings) with a short TTL, invalidated on admin save. Wallet balances, lead
# purchase/assignment state and payment status always read Postgres directly.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
