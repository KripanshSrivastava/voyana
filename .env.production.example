# -----------------------------------------------------------------------------
#  .env.production.example — copy to `.env.production` on the VPS and fill in.
#
#  NEVER commit the filled-in file. Docker Compose reads this via `env_file:`
#  in docker-compose.yml. Values are the same names your Next.js app already
#  reads from process.env — no code change required.
#
#  Domain-level bits (used by docker-compose.yml itself, not Next):
# -----------------------------------------------------------------------------

# The canonical domain for your site, without protocol.
APP_DOMAIN=mokshbooking.app

# Email address ACME uses for Let's Encrypt account + expiry warnings.
LETSENCRYPT_EMAIL=you@example.com


# -----------------------------------------------------------------------------
#  Application-level env vars — same names lib/ already reads.
# -----------------------------------------------------------------------------

# Public origin used for link generation (emails, invites, redirects).
APP_URL=https://mokshbooking.app

# Supabase Postgres (pooled + direct). Keep hosting on Supabase.
DATABASE_URL=postgresql://…pooled…
DIRECT_URL=postgresql://…direct…

# Supabase Auth + Storage.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ…
SUPABASE_SERVICE_ROLE_KEY=eyJ…

# Upstash Redis for rate limiting + public caches.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=…

# Resend transactional email.
RESEND_API_KEY=re_…
EMAIL_FROM_NAME=Moksh Booking
EMAIL_SEND_DOMAIN=send.mokshbooking.app
EMAIL_VERIFICATION_EXPIRES_MINUTES=15

# Razorpay (legacy INR wallet path).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Inbound webhook secrets — leave blank to disable that channel.
GOOGLE_LEADS_WEBHOOK_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
VOYANA_API_KEY=

# Optional destination for the "new lead" admin email fanout.
ADMIN_EMAIL=admin@mokshbooking.app
