# -----------------------------------------------------------------------------
#  .env.production.example
#
#  Copy to `.env.production` on the VPS and REPLACE every FILL_IN value.
#  NEVER commit the filled-in file. Docker Compose reads this at RUNTIME via
#  `env_file:` in docker-compose.yml. The Docker BUILD does not read this file
#  — the app is designed to build offline against defaults, then use these
#  values only when the container starts.
#
#  The `FILL_IN_*` sentinels are deliberately plain ASCII and obvious. If you
#  see one of them URL-encoded or displayed in a log, that env var was never
#  replaced. Grep the file for FILL_IN before deploying — should return zero.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
#  Docker / DNS layer — used by docker-compose.yml itself, not by Next.
# -----------------------------------------------------------------------------

# The canonical apex domain for your site, without protocol or www.
APP_DOMAIN=FILL_IN_APEX_DOMAIN_HERE

# Email address ACME uses for Let's Encrypt account + cert expiry warnings.
LETSENCRYPT_EMAIL=FILL_IN_YOUR_EMAIL


# -----------------------------------------------------------------------------
#  Application env — the exact names lib/ already reads via process.env.
# -----------------------------------------------------------------------------

# Public origin used for link generation (emails, invites, redirects).
APP_URL=https://FILL_IN_APEX_DOMAIN_HERE

# Supabase Postgres. `pooled` is the Supavisor 6543 pooler; `direct` is 5432.
DATABASE_URL=postgresql://FILL_IN_POOLED_CONNECTION_STRING
DIRECT_URL=postgresql://FILL_IN_DIRECT_CONNECTION_STRING

# Supabase Auth + Storage.
NEXT_PUBLIC_SUPABASE_URL=https://FILL_IN_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=FILL_IN_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=FILL_IN_SERVICE_ROLE_KEY

# Upstash Redis (used by rate limits, lockout, public caches).
UPSTASH_REDIS_REST_URL=https://FILL_IN.upstash.io
UPSTASH_REDIS_REST_TOKEN=FILL_IN_UPSTASH_TOKEN

# Resend transactional email. WITHOUT this, 2FA / password-reset / admin invite
# emails silently fail — the mailer will log to IntegrationLog(status=FAILED)
# visible at /admin/integrations/logs.
RESEND_API_KEY=re_FILL_IN
EMAIL_FROM_NAME=Moksh Booking
EMAIL_SEND_DOMAIN=FILL_IN_VERIFIED_SEND_DOMAIN
EMAIL_VERIFICATION_EXPIRES_MINUTES=15

# WhatsApp messaging via the self-hosted `whatsapp` service (open-wa — an
# UNOFFICIAL WhatsApp Web automation client, not Meta's Cloud API). Leave
# WHATSAPP_SERVICE_URL blank to disable WhatsApp entirely — lead alerts and
# customer acknowledgements then silently no-op and record a FAILED row in
# IntegrationLog so the gap is visible at /admin/integrations/logs.
# WHATSAPP_SERVICE_SECRET must be the same value in both this file's app
# section and the `whatsapp` service's env — generate one random string and
# use it for both. See docs/WHATSAPP.md for the QR login step and the
# ban-risk tradeoffs of this approach.
WHATSAPP_SERVICE_URL=http://whatsapp:4000
WHATSAPP_SERVICE_SECRET=FILL_IN_RANDOM_SECRET

# Razorpay (legacy INR wallet path). Leave blank to disable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Inbound webhook secrets — leave blank to disable that channel.
GOOGLE_LEADS_WEBHOOK_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
VOYANA_API_KEY=

# Optional destination for the "new lead" admin email fanout.
ADMIN_EMAIL=
